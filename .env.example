# FirstRead AI SEO Dashboard — Environment Configuration Template
# Copy to .env.local for local development, or configure in Vercel Project Settings for Staging/Production.
# NEVER commit real credentials or secrets to version control.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION (MANDATORY FOR STAGING)
# -----------------------------------------------------------------------------
# Base URL for the dashboard (used for CSRF same-origin validation & absolute links)
# Local: http://localhost:3000 | Staging: https://<staging-app>.vercel.app
APP_URL=http://localhost:3000

# Administrative Dashboard Authentication
# Generate hash: npm run admin:hash (minimum 16 characters recommended)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:c2FsdHNhbHQ:6b59...

# Session Cookie Signing Secret (minimum 32 characters, base64url recommended)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long

# Custom Reports Directory (Optional)
# Leave blank for default local path (./content/reports).
# On serverless runtimes with read-only root filesystems, set to /tmp for ephemeral runtime writes.
REPORTS_DIR=

# -----------------------------------------------------------------------------
# 2. AI RECOMMENDATIONS ENGINE (OPTIONAL)
# -----------------------------------------------------------------------------
# Google Gemini API key for advanced natural-language title & link refinement.
# If omitted, dashboard operates safely in deterministic heuristic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 3. GOOGLE SEARCH CONSOLE & GA4 INTEGRATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Google Cloud Service Account credentials for read-only GSC & GA4 reporting.
# If omitted, dashboard truthfully displays unconfigured status without fabricating metrics.
FIRSTREAD_GSC_PROPERTY=sc-domain:firstread.co.uk
FIRSTREAD_GA4_PROPERTY_ID=
GOOGLE_CLIENT_EMAIL=
# PEM private key with literal \n escapes: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PRIVATE_KEY=
