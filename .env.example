# Copy to .env.local; never commit real values.
APP_URL=http://localhost:3000
ADMIN_USERNAME=
# npm run admin:hash (16+ characters); scrypt:salt:hash
ADMIN_PASSWORD_HASH=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Private repository owner/name. Use a preview content branch until launch approval.
GITHUB_REPOSITORY=
GITHUB_BRANCH=cms-content
GITHUB_TOKEN=
GOOGLE_CLIENT_EMAIL=
# PEM private key with literal \n escapes or multiline value in hosting settings
GOOGLE_PRIVATE_KEY=
GSC_PROPERTY=sc-domain:spotmagazine.co.uk
GA4_PROPERTY_ID=
GEMINI_API_KEY=
# Choose an available structured-output model in your Google project.
GEMINI_MODEL=
# GitHub Actions only; also requires settings.publishingEnabled + reviewed schedule.
APPROVED_SCHEDULES=false

# Keep false for local/preview. Enable only on the approved production deployment.
ALLOW_INDEXING=false
